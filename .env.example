# NEXUS — copy to .env and fill only the services you want to enable.
# Core SIH demo works without paid APIs. Blank credentials are valid.

# Core
NEXUS_ENV=demo
NEXUS_DB_URL=sqlite:///./nexus.db
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8000
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
K_ANON_MIN_GROUP=10
PSEUDONYM_SALT=change-me-for-non-demo-use
PUBLIC_HTTP_TIMEOUT_SECONDS=15

# X — official recent-search is pay-per-use when configured.
X_BEARER_TOKEN=
X_MAX_RESULTS_PER_RUN=50
X_MAX_PAGES_PER_RUN=2
X_REQUEST_TIMEOUT_SECONDS=15
# Free official fallback for known public Post URLs uses publish.x.com oEmbed.
# Optional permitted RSS/Atom bridge may contain {query} and/or {target}.
X_PUBLIC_RSS_URL_TEMPLATE=

# Telegram — primary zero-cost SIH source.
TELEGRAM_PUBLIC_CHANNELS=NexusSIHDemo
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT_SECONDS=5
# Optional MTProto remains disabled and is not needed for the SIH demo.
TELEGRAM_MTPROTO_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=nexus_sih

# YouTube — zero-key yt-dlp public video metadata works without this key.
# Add the Data API key for official video + comment/reply collection.
YOUTUBE_API_KEY=
YOUTUBE_MAX_VIDEOS_PER_RUN=5
# 0 means provider-exhaustive: follow every nextPageToken until YouTube has no
# more public comments/replies or the provider itself rate-limits/blocks access.
# Set a positive number only when you intentionally want an operator-side cap.
YOUTUBE_MAX_COMMENTS_PER_VIDEO=0
YOUTUBE_MAX_COMMENT_PAGES_PER_VIDEO=0
YOUTUBE_MAX_REPLY_PAGES_PER_THREAD=0

# Meta / Instagram / Facebook — authorized professional/Page access.
META_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
# Optional permitted Instagram RSS/public bridge; otherwise public-profile mode
# falls back to Instaloader and never bypasses private/login controls.
INSTAGRAM_PUBLIC_RSS_URL_TEMPLATE=

# Reddit — low-volume public JSON is attempted automatically.
# If approved OAuth credentials are available, NEXUS tries OAuth first and then
# falls back to public JSON when appropriate.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NEXUS-SIH26152/0.5
REDDIT_ENABLED=true

# Mastodon — NEXUS tries the preferred instance first, then configured fallbacks.
MASTODON_BASE_URL=https://mastodon.social
MASTODON_FALLBACK_BASE_URLS=https://mastodon.online,https://fosstodon.org

# Analytics
NEXUS_ENABLE_TRANSFORMERS=false
NEXUS_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
NEXUS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEXUS_CLUSTER_SIMILARITY_THRESHOLD=0.42
NEXUS_ALERT_TREND_THRESHOLD=0.62

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_JAVA_GATEWAY=false
VITE_JAVA_GATEWAY_URL=http://127.0.0.1:8080
