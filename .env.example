# NEXUS — copy to .env and fill only the services you want to enable.
# Core SIH demo works without paid APIs. Blank credentials are valid.

# Core
NEXUS_ENV=demo
NEXUS_DB_URL=sqlite:///./nexus.db
NEXUS_API_HOST=127.0.0.1
NEXUS_API_PORT=8000
NEXUS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
K_ANON_MIN_GROUP=10
PSEUDONYM_SALT=change-me-for-non-demo-use
PUBLIC_HTTP_TIMEOUT_SECONDS=15

# X API v2 — official richer connector; current X access is pay-per-use.
X_BEARER_TOKEN=
X_MAX_RESULTS_PER_RUN=50
X_MAX_PAGES_PER_RUN=2
X_REQUEST_TIMEOUT_SECONDS=15
# FREE official path: paste one/more public X Post URLs into the Free Source Lab
# target box and use `+ X URL / Bridge`; NEXUS uses publish.x.com oEmbed with
# no auth. This fetches known public Post URLs; it is NOT unrestricted free X search.
# Optional RSS/Atom bridge under your control or a permitted public provider.
# Template may contain {query} and/or {target}; leave blank when unavailable.
X_PUBLIC_RSS_URL_TEMPLATE=

# Telegram — primary zero-cost SIH source.
# Comma-separated PUBLIC channel usernames monitored by every Fresh Search.
# Example: TELEGRAM_PUBLIC_CHANNELS=MyDemoChannel,PIB_India
# NEXUS collects latest public-preview posts and locally filters them by the
# active search query, so unrelated Telegram posts do not pollute the workspace.
TELEGRAM_PUBLIC_CHANNELS=
# Bot API is an additional free LIVE path for chats/channels visible to your bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT_SECONDS=5

# Optional Telegram MTProto — disabled by default and NOT needed for the SIH demo.
TELEGRAM_MTPROTO_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=nexus_sih

# YouTube Data API v3 — optional official quota-based path.
# With this blank, /api/connectors/youtube/free uses yt-dlp public video metadata.
YOUTUBE_API_KEY=
YOUTUBE_MAX_VIDEOS_PER_RUN=5
YOUTUBE_MAX_COMMENTS_PER_VIDEO=30

# Meta / Instagram / Facebook — official authorized professional/page access.
META_GRAPH_VERSION=v23.0
META_ACCESS_TOKEN=
META_INSTAGRAM_ACCOUNT_ID=
META_FACEBOOK_PAGE_ID=
# Optional permitted RSS/public bridge for Instagram; profile fallback otherwise uses Instaloader.
INSTAGRAM_PUBLIC_RSS_URL_TEMPLATE=

# Reddit — public JSON is attempted at low volume; OAuth/import can be added if the network blocks it.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=NEXUS-SIH26152/0.4
REDDIT_ENABLED=true

# Mastodon public instance used by the free connector.
MASTODON_BASE_URL=https://mastodon.social

# Analytics
NEXUS_ENABLE_TRANSFORMERS=false
NEXUS_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
NEXUS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
NEXUS_CLUSTER_SIMILARITY_THRESHOLD=0.42
NEXUS_ALERT_TREND_THRESHOLD=0.62

# Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_USE_JAVA_GATEWAY=false
VITE_JAVA_GATEWAY_URL=http://127.0.0.1:8080
